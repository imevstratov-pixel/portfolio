{
  "name": "portfolio-v2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Daniil Evstratov portfolio, black-and-white Astro build (v1)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check-links": "node tools/check-links.mjs",
    "shots": "node tools/shots.mjs",
    "leakcheck": "bash tools/leakcheck.sh",
    "verify": "npm run build && npm run check-links && npm run leakcheck",
    "content": "python3 -I \"$SITE_CONTENT/tools/export_public.py\" \"$SITE_CONTENT/src/content\" src/content"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "astro": "^7.3.8",
    "embla-carousel": "8.6.0",
    "embla-carousel-wheel-gestures": "8.1.0",
    "motion": "13.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3"
  }
}
