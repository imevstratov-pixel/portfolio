---
// One service on /services/ as a compact card (decisions 8, 10, 16 and 17 of
// 14.10), ported from render_card() and render_service() in the texts
// renderer.
//
// Card: number (`isNew`: the «new» sticker beside it, NewBadge), title, the
// italic one-line summary; the three `highlights`,
// «Срок» and «Цена» (ServiceTerms: the duration, then the PriceBlock with the
// figure in the title's size, regular, the note and the sub-prices, or the global line when the
// service has no price), the verb button (`button`, e.g. «Заказать аудит
// курса»: the Telegram action that copies the start of the message with the
// codeword). The copy hint and the email line are not repeated on every
// card: ServicesIntro shows them once under «Не нашли своё?», and the
// contact block at the bottom.
// The title links to the service's own page (servicePageHref: /services/<slug>/,
// /guide/ for the guide).
// «Подробнее» (Disclosure: a native details, on a spring when motion is allowed) opens the full
// template on the spot (ServiceFull). While it is open its «Свернуть» sticks
// under the site header with the service's short name beside it, and a
// second «Свернуть» at the end closes it and jumps back to the top of this
// card (data-disclose-root).
// page (the service's own page, /services/<slug>/): the same head and offer
// without the number and the sticker, the title as the page's h1 (`seo.h1`
// when the content has one) across the grid with the offer under it, then
// the full template open, without «Подробнее».
// short (group variant "short", the guide): the same card with the `more`
// link («Подробнее о тренажёре», /guide/) beside the verb button; its
// «Подробнее» opens «Для кого» and «Что получите на руки» only.
//
// Layout: an ink line on top. From 720px the card has two halves on the page
// grid: number, title and summary in columns 1-6, the offer in 7-12. The
// parts of the full template are rows (ServicePart): the name in 1-3, the
// text in 4-10. The scheme takes the full width. Phones: one column.
import ServicePart from './ServicePart.astro';
import ServiceFull from './ServiceFull.astro';
import Disclosure from '../Disclosure.astro';
import ServiceTerms from '../ServiceTerms.astro';
import TelegramAction from '../TelegramAction.astro';
import NewBadge from '../NewBadge.astro';
import { getService, servicePageHref, visible, type ServiceEntry } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  service: string | ServiceEntry;
  /** pages/services.md serviceTemplate.labels. */
  labels: Record<string, string>;
  /** Position on the page (1–7), shown as «01». Not shown on the service's page. */
  number?: number;
  /** Short variant (service-group with variant: short). */
  short?: boolean;
  /** The service's own page: h1, no number, the full template open. */
  page?: boolean;
}

const { service, labels, number = 0, short = false, page = false } = Astro.props;
const s = typeof service === 'string' ? getService(service) : service;
const d = s.data;
const titleId = `${d.anchor}-title`;
const num = String(number).padStart(2, '0');
const highlights = visible(d.highlights).filter(Boolean);
const title: string = page ? d.seo?.h1?.trim() || d.title : d.title;
// the page's large h1 never breaks a word at its hyphen («онлайн-/курса»)
// (split with a capture group: the hyphenated words sit at the odd positions)
const titleParts = title.split(/(\S+-\S+)/);
// «Свернуть»: the open summary and the button at the end of the text
// (serviceTemplate.labels.less when the content has it)
const less = labels.less || 'Свернуть';
---

<article
  id={d.anchor}
  class:list={['svc', short && 'svc--short', page && 'svc--page']}
  aria-labelledby={titleId}
  data-disclose-root={page ? undefined : ''}
>
  <div class="svc__card">
    <header class="svc__head">
      {!page && <p class="label svc__num">{num}</p>}
      {!page && d.isNew && <NewBadge class="svc__new" />}
      {
        page ? (
          <h1 id={titleId} class="svc__title t-large">
            {titleParts.map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}
          </h1>
        ) : (
          <h3 id={titleId} class="svc__title">
            <a href={servicePageHref(s)}>{title}</a>
          </h3>
        )
      }
      <p class="svc__summary">{d.summary}</p>
    </header>

    <div class="svc__offer">
      {
        highlights.length > 0 && (
          <ul class="list-dash svc__points" role="list">
            {highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )
      }
      <ServiceTerms service={s} class="svc__terms" />
      <div class="svc__cta">
        <TelegramAction codeword={d.codeword} label={d.button} caption={false} hint={false} email={false} class="svc__action" />
        {
          short && d.more && (
            <p class="svc__more-link">
              <a href={url(d.more.url)}>{d.more.label}</a>
            </p>
          )
        }
      </div>
    </div>
  </div>

  {
    short ? (
      <Disclosure more={labels.more} less={less} context={d.short} class="svc__more">
        <div class="svc__full">
          <ServicePart label={labels.forWhom}>
            <ul class="list-dash" role="list">
              {d.forWhom.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </ServicePart>
          <ServicePart label={labels.youGet}>
            <ul class="list-dash" role="list">
              {d.youGet.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </ServicePart>
        </div>
      </Disclosure>
    ) : page ? (
      <ServiceFull service={s} labels={labels} level={2} class="svc__page-full" />
    ) : (
      <Disclosure more={labels.more} less={less} context={d.short} class="svc__more">
        <ServiceFull service={s} labels={labels} class="svc__full" />
      </Disclosure>
    )
  }
</article>

<style>
  .svc {
    position: relative;
    padding-top: var(--s2);
    border-top: var(--line);
  }

  .svc__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s3) var(--gap);
    align-items: start;
  }

  .svc__head {
    display: grid;
    align-content: start;
    gap: var(--s2);
  }

  .svc__num {
    margin-bottom: calc(var(--s1) - var(--s2));
  }

  .svc__title {
    max-width: 18em;
  }

  /* `isNew`: the sticker on the top edge of the card, beside the number */
  .svc :global(.svc__new) {
    --nb-size: 4rem;
    position: absolute;
    top: -1.25rem;
    left: 2.5rem;
  }

  /* the one-line description in italic (as the texts ask), base size under
     the medium bold title, so the pair reads as title and line */
  .svc__summary {
    font-style: italic;
    max-width: 60ch;
  }

  .svc__offer {
    display: grid;
    align-content: start;
    gap: var(--s2);
  }

  .svc__points {
    gap: 0.35rem;
  }

  /* the verb button; the guide's «Подробнее о тренажёре» beside it */
  .svc__cta {
    margin-top: var(--s1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s3);
  }

  /* the Disclosure renders the details itself: style it through :global */
  .svc :global(.svc__more) {
    margin-top: var(--s3);
  }

  /* the short variant's parts; the full template (ServiceFull) gets the same
     space above */
  .svc__full,
  .svc :global(.svc__full) {
    display: grid;
    align-content: start;
    gap: var(--s3);
    margin-top: var(--s3);
  }

  /* the service's own page: no line on top (the page starts with «Все
     услуги»), the full template a step further down */
  .svc--page {
    padding-top: 0;
    border-top: 0;
  }

  .svc--page .svc__title {
    max-width: 16em;
  }

  .svc :global(.svc__page-full) {
    margin-top: var(--s4);
  }

  @media (min-width: 720px) {
    .svc__card {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .svc__head {
      grid-column: 1 / span 6;
      padding-right: var(--s3);
    }

    .svc__offer {
      grid-column: 7 / span 6;
    }
  }

  /* the service's page: the large h1 in half the grid took four lines, so
     the head gets the width (as a case page title) and the offer follows
     under it on the left (the list keeps its halves) */
  @media (min-width: 720px) {
    .svc--page .svc__head {
      grid-column: 1 / span 10;
      padding-right: 0;
    }

    .svc--page .svc__offer {
      grid-column: 1 / span 7;
    }
  }
</style>
