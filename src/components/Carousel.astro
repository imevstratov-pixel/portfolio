---
// A horizontal row of slides (decision 11 of 14.10): «Что говорят коллеги»
// on the home page, /hire/ and /cases/, and the product galleries.
//
// Static HTML first: the row (track) scrolls sideways with scroll snap
// (swipe on phones, trackpad or the keyboard elsewhere) and always shows
// part of the next slide. Under it a bar: «1 из 5» in mono and the buttons
// «Назад» and «Дальше». The bar shows only once the script has run
// (data-ready): without JS the row still scrolls by swipe or trackpad, and
// no counter can name the wrong slides. When every slide fits, the script
// removes the bar (data-static). One slide: no bar at all.
//
// Motion (decision 2 of 15.10, src/scripts/carousel.ts): when the system
// allows motion, the row becomes an Embla Carousel (the engine of the
// shadcn/ui carousel) once it comes near the screen: drag with the mouse,
// swipe, trackpad (wheel gestures plugin), momentum and snap to a slide,
// the buttons and the arrow keys glide to the next slide; Tab into a slide
// brings it into view. The track then clips (data-embla) and the rail moves.
// With prefers-reduced-motion the native row stays and the buttons move by
// one slide at once, as before; Embla is not even loaded.
//
// Accessibility: the row is a focusable region named by `label`
// (aria-roledescription «карусель»), the arrow keys move by one slide; each
// slide is a group «2 из 5»; the buttons are real buttons with text and
// aria-controls. The counter is a polite live region (aria-atomic), so «2 из 5»
// is announced once the row has come to rest after «Дальше», «Назад», a key
// or a swipe. Every slide stays in the DOM, so screen readers read them all.
//
// Usage: pass the items and a function child that renders one slide.
//   <Carousel items={list} label="Что говорят коллеги" id="home-voices">
//     {(t) => <VideoTestimonial testimonial={t} layout="card" size="medium" />}
//   </Carousel>
//   <Carousel items={shots} kind="media" ratios={shots.map(…)} label={…} id={…}>
//     {(g) => <figure>…</figure>}
//   </Carousel>
// kind "cards" (default): slide width 85% of the row on phones, 60% on
// tablets, 5 of 12 columns from 1080px; a swipe moves one card. kind
// "media": every slide has the row height and the width of its own ratio
// (`ratios`, width / height), at most 85% of the row; pass `height` to
// change the row height; a flick may travel past several shots.
// bleed: the row runs into the side gutters (to the screen edges on phones).

interface Props {
  items: unknown[];
  /** Accessible name of the row (usually the section heading). */
  label: string;
  /** Unique id prefix on the page. */
  id: string;
  kind?: 'cards' | 'media';
  /** kind "media": width / height of each slide, in item order. */
  ratios?: number[];
  /** kind "media": row height from 1080px (default 30rem; phones 25rem, tablets 26rem). */
  height?: string;
  bleed?: boolean;
  class?: string;
}

const {
  items,
  label,
  id,
  kind = 'cards',
  ratios,
  height,
  bleed = false,
  class: className,
} = Astro.props;

const n = items.length;
const slides: string[] = [];
for (let i = 0; i < n; i++) slides.push(await Astro.slots.render('default', [items[i], i]));
const trackId = `${id}-track`;
const slideStyle = (i: number) => {
  const r = ratios?.[i];
  return kind === 'media' && r ? `--r: ${r.toFixed(4)}` : undefined;
};
const rootStyle = height ? `--h-lg: ${height}` : undefined;
---

{
  n > 0 && (
    <div
      class:list={['carousel', `carousel--${kind}`, bleed && 'carousel--bleed', className]}
      style={rootStyle}
      data-carousel={kind}
    >
      <div
        class="carousel__track"
        id={trackId}
        role="region"
        aria-roledescription="карусель"
        aria-label={label}
        tabindex="0"
        data-carousel-track
      >
        <div class="carousel__rail" data-carousel-rail>
          {slides.map((html, i) => (
            <div
              class="carousel__item"
              role="group"
              aria-roledescription="слайд"
              aria-label={`${i + 1} из ${n}`}
              style={slideStyle(i)}
              set:html={html}
            />
          ))}
        </div>
      </div>
      {n > 1 && (
        <div class="carousel__bar">
          <p class="carousel__count" aria-atomic="true" data-carousel-count>
            <span data-carousel-pos>1</span> из {n}
          </p>
          <div class="carousel__nav">
            <button type="button" class="carousel__btn" aria-controls={trackId} data-carousel-prev disabled>
              Назад
            </button>
            <button type="button" class="carousel__btn" aria-controls={trackId} data-carousel-next disabled>
              Дальше
            </button>
          </div>
        </div>
      )}
    </div>
  )
}

<script>
  import '../scripts/carousel.ts';
</script>

<style>
  .carousel {
    --h: 25rem;
    display: grid;
    /* one column that never grows past the container: with Embla the track
       clips (overflow: clip is not a scroll container), so its automatic
       minimum width would be the rail's min-content and push the bleed row
       past the screen edge */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s2);
    min-width: 0;
  }

  /* the track scrolls (no JS, reduced motion) or clips while Embla moves
     the rail (data-embla); the slides measure their offsetLeft from it */
  .carousel__track {
    position: relative;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
    padding-bottom: var(--s1);
  }

  .carousel__rail {
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
  }

  /* Embla: no native scrolling, the rail follows the finger or the mouse;
     vertical swipes still scroll the page */
  .carousel[data-embla] .carousel__track {
    overflow: clip;
    scroll-snap-type: none;
    cursor: grab;
    /* the native track's scrollbar (classic scrollbars), measured by the
       script, so the row keeps its height in both modes */
    padding-bottom: calc(var(--s1) + var(--carousel-sb, 0px));
  }

  .carousel[data-embla] .carousel__rail {
    touch-action: pan-y pinch-zoom;
  }

  .carousel[data-embla][data-dragging] .carousel__track {
    cursor: grabbing;
    user-select: none;
  }

  .carousel[data-embla][data-static] .carousel__track {
    cursor: auto;
  }

  .carousel--bleed .carousel__track {
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }

  /* native row with bleed: the last slide stops at the gutter, as the
     first starts at it (a block's end padding is not scrollable overflow) */
  .carousel--bleed:not([data-embla]) .carousel__rail::after {
    content: '';
    flex: 0 0 max(0px, calc(var(--gutter) - var(--gap)));
    align-self: stretch; /* a box with no height adds no scrollable overflow */
  }

  .carousel__item {
    flex: 0 0 auto;
    min-width: 0;
    scroll-snap-align: start;
  }

  /* cards: the next card always shows at the edge */
  .carousel--cards .carousel__item {
    width: 85%;
  }

  /* media: one row height, each slide as wide as its ratio allows */
  .carousel--media .carousel__item {
    width: min(85%, calc(var(--h) * var(--r, 1)));
  }

  @media (min-width: 720px) {
    .carousel {
      --h: 26rem;
    }

    .carousel--cards .carousel__item {
      width: 60%;
    }
  }

  @media (min-width: 1080px) {
    .carousel {
      --h: var(--h-lg, 30rem);
    }

    /* 5 of the 12 page columns */
    .carousel--cards .carousel__item {
      width: calc((100% - 11 * var(--gap)) / 12 * 5 + 4 * var(--gap));
    }

    .carousel--media .carousel__item {
      width: min(75%, calc(var(--h) * var(--r, 1)));
    }
  }

  .carousel__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s1) var(--s2);
  }

  /* no script yet (or none): no bar; every slide fits: nothing to scroll */
  .carousel:not([data-ready]) .carousel__bar,
  .carousel[data-static] .carousel__bar {
    display: none;
  }

  .carousel__count {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--muted);
  }

  .carousel__nav {
    display: flex;
    gap: var(--s1);
  }

  /* small framed buttons; hover inverts, as every button on the site */
  .carousel__btn {
    min-height: 2.75rem;
    min-width: 6.5rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: var(--bold);
    line-height: 1.2;
  }

  .carousel__btn:hover:not(:disabled, [aria-disabled='true']) {
    background: var(--ink);
    color: var(--paper);
  }

  .carousel__btn:disabled,
  .carousel__btn[aria-disabled='true'] {
    border-color: var(--rule);
    color: var(--muted);
    cursor: default;
  }
</style>
