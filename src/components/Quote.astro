---
// A quote with its attribution. The text is shown exactly as approved
// (spacing preserved); guillemets are added by CSS, not to the text.
interface Props {
  text: string;
  /** Attribution line, e.g. «Близкий человек, для которого я собрал тренажёр». */
  cite?: string;
  size?: 'large' | 'medium' | 'base';
  /** Add «» around the text (default true). */
  marks?: boolean;
  class?: string;
}

const { text, cite, size = 'large', marks = true, class: className } = Astro.props;
---

<figure class:list={['quote', `quote--${size}`, marks && 'quote--marks', className]}>
  <blockquote class="quote__text"><p>{text}</p></blockquote>
  {cite && <figcaption class="quote__cite label">{cite}</figcaption>}
</figure>

<style>
  .quote__text p {
    white-space: pre-wrap;
    max-width: 34em;
  }

  .quote--large .quote__text {
    font-size: var(--fs-large);
    line-height: 1.12;
    letter-spacing: var(--track-large);
  }

  .quote--medium .quote__text {
    font-size: var(--fs-medium);
    line-height: 1.3;
    letter-spacing: var(--track-medium);
  }

  .quote--marks .quote__text p::before {
    content: '«';
  }

  .quote--marks .quote__text p::after {
    content: '»';
  }

  .quote__cite {
    margin-top: var(--s2);
  }
</style>
