---
// «Обо мне» (block "about"): portrait on the left (4 of 12 columns; half the
// width on phones), the paragraphs on the right (8 of 12). The real photo
// (`photo { src, alt }`, decision 9 of 14.10) replaces the drawn portrait
// when it is visible: same column (half the width on phones), a 4:5 frame;
// while it is hidden (the export drops it) the drawn portrait stays. /hire/
// keeps the drawn one. Under them the short experience across the grid
// between thin rules: years in mono under the portrait column, place, role
// and note under the text (stacked on phones). Then «Весь опыт по годам» to /hire/#experience and the line about
// own products with «Мои продукты», aligned with the text column.
import Section from '../Section.astro';
import Media from '../Media.astro';
import { isHidden, visible, type Block } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  block: Block;
}

const { block: b } = Astro.props;
const text = visible<string>(b.text).filter(Boolean);
const experience = visible(b.experience);
const pl = b.productsLine;
const photo = b.photo?.src && !isHidden(b.photo) ? (b.photo as { src: string; alt?: string }) : null;
const picture = photo
  ? { src: photo.src, alt: photo.alt ?? b.portraitAlt ?? '', ratio: '4 / 5' }
  : b.portrait
    ? { src: b.portrait as string, alt: b.portraitAlt as string, ratio: '1 / 1' }
    : null;
---

<Section id={b.anchor} heading={b.heading}>
  <div class="grid about">
    {
      picture && (
        <div class="about__portrait col-4 m-col-2">
          <Media src={picture.src} alt={picture.alt} ratio={picture.ratio} />
        </div>
      )
    }
    {
      text.length > 0 && (
        <div class:list={['about__text', picture ? 'col-8' : 'col-8 start-5']}>
          {text.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      )
    }
    {
      experience.length > 0 && (
        <ul class="about__exp list-rules" role="list">
          {experience.map((e: any) => (
            <li class="about__row grid">
              <p class="about__years t-small col-4">{e.years}</p>
              <div class="about__what col-8">
                <p>
                  <strong>{e.place}</strong>
                </p>
                {e.role && <p>{e.role}</p>}
                {e.note && <p class="about__detail">{e.note}</p>}
              </div>
            </li>
          ))}
        </ul>
      )
    }
    {
      (b.experienceLink?.href || pl?.text) && (
        <div class="about__links col-8 start-5">
          {b.experienceLink?.href && (
            <p>
              <a href={url(b.experienceLink.href)}>{b.experienceLink.label}</a>
            </p>
          )}
          {pl?.text && (
            <p>
              {pl.text}
              {pl.href && pl.linkLabel && (
                <>
                  {' '}
                  <a href={url(pl.href)}>{pl.linkLabel}</a>
                </>
              )}
            </p>
          )}
        </div>
      )
    }
  </div>
</Section>

<style>
  .about {
    align-items: start;
    row-gap: var(--s4);
  }

  .about__text {
    display: grid;
    gap: 0.8em;
    max-width: var(--measure);
    font-size: var(--fs-medium);
    line-height: 1.4;
    letter-spacing: var(--track-medium);
  }

  /* experience: years under the portrait column, the rest under the text */
  .about__row {
    row-gap: var(--s1);
    align-items: baseline;
  }

  .about__what {
    max-width: var(--measure);
  }

  .about__detail {
    color: var(--muted);
  }

  .about__links {
    display: grid;
    gap: var(--s2);
    max-width: var(--measure);
  }
</style>
