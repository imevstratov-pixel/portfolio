---
// The multi-agent scheme from the old site (/home/user/portfolio/index.html,
// block .scheme), redrawn in black and white for the content field
// `scheme: "ai-agents"` (case staff-c2 and services/ai-agents.md).
//
// Same structure as the old SVG: input and the methodologist on the left,
// the task distributor, three groups of agents (course programme, lessons,
// translations), two human checks, the output column and the shared base
// at the bottom. Labels follow the case text (decision 2 of 14.10: the
// neutral words «AI-агенты» and «система»), no English names of system
// parts, no company or platform names, no text arrows or middle dots (the
// connectors keep small arrowheads to show the direction).
//
// Colour: ink, paper and muted only (tokens). Type: Inter Tight for box
// titles, IBM Plex Mono for labels. Every label is at least 11 viewBox units,
// and the drawing is never scaled down (min-width 1180px = the viewBox), so
// the smallest label renders at 11px or more.
// Widths of the component's own container (container queries):
// - 1180px and wider: the drawing at the full width (1184px at a 1280px window);
// - 720–1179px: the drawing at 1:1 scrolls sideways, the hint
//   «Схему можно прокрутить вбок» stands above it;
// - below 720px (phones, tablets in portrait): the same labels as a vertical
//   list instead of the drawing: Вход, задача, Распределение, the three
//   groups of AI-агенты with the two human checks, Выход, the shared base.
//   Boxes are 1px frames, connectors are 1px rules with a small arrowhead.
//
// Usage:
//   <AgentsScheme idPrefix={`${c.data.anchor}-scheme`} level={3} facts={false} />  (/cases/: the case infographic carries the numbers)
//   <AgentsScheme level={5} titleSize="base" idPrefix={`${anchor}-scheme`} />          (/hire/, with the facts)
//   <AgentsScheme heading={false} facts={false} idPrefix="ai-agents-scheme" />        (/services/)
// The texts renderer (build_texts.py, SCHEMES) keeps a copy of the heading,
// the description, the facts and the hint: change both together.
interface Props {
  /** Heading above the scheme; `false` hides it. */
  heading?: string | false;
  /** Heading level (default 3). */
  level?: 2 | 3 | 4 | 5 | 6;
  /** Heading size: "medium" (default, /cases/) or "base" (under a base-size case title on /hire/). */
  titleSize?: 'medium' | 'base';
  /** Fact line under the scheme; `false` hides it. */
  facts?: string[] | false;
  /** Hint shown when the scheme scrolls sideways. */
  hint?: string;
  /** Prefix for ids (title, desc, markers); unique per page. */
  idPrefix?: string;
  class?: string;
}

const {
  heading = 'Как устроены AI-агенты',
  level = 3,
  titleSize = 'medium',
  facts = ['20+ агентов', '2 проверки человеком', '5 языков', 'расход на нейросети вдвое ниже', '×26 к скорости выпуска'],
  hint = 'Схему можно прокрутить вбок',
  idPrefix = 'agents-scheme',
  class: className,
} = Astro.props;

const Tag = `h${level}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const id = (s: string) => `${idPrefix}-${s}`;
const arrow = `url(#${id('arrow')})`;
const factList = (facts || []).filter(Boolean);

const title = 'Схема AI-агентов для разработки курсов';
const desc =
  'Материалы курса и задача от методиста приходят к агенту-распределителю. ' +
  'Он отправляет задачу одной из трёх групп AI-агентов. ' +
  'Программа курса: черновик, критика, оценка; программу проверяет человек, и она идёт в уроки. ' +
  'Уроки: разбор, редактура, проверка формы, проверка правил; ошибки, которые нашли проверки, агенты чинят сами; каждый урок проверяет человек. ' +
  'Переводы: распределитель переводов даёт каждому агенту один файл и один язык, с английского на 4 языка. ' +
  'Дальше форматирование под учебную платформу, сборка и готовый курс в учебной платформе. ' +
  'Общая основа для всех агентов: типы заданий, правила курса, словари терминов, скрипты-проверки, потолок расходов на нейросети.';
---

<div class:list={['agents-scheme', className]} aria-labelledby={heading ? id('heading') : undefined} role={heading ? 'group' : undefined}>
  {
    heading && (
      <Tag id={id('heading')} class:list={['agents-scheme__title', `agents-scheme__title--${titleSize}`]}>
        {heading}
      </Tag>
    )
  }
  {hint && <p class="agents-scheme__hint">{hint}</p>}
  <div class="agents-scheme__scroll" tabindex="0" role="region" aria-label={title}>
    <svg
      class="agents-scheme__svg"
      viewBox="0 0 1180 648"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby={`${id('title')} ${id('desc')}`}
    >
      <title id={id('title')}>{title}</title>
      <desc id={id('desc')}>{desc}</desc>
      <defs>
        <marker id={id('arrow')} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="sv-fill" d="M0,0 L10,5 L0,10 z" />
        </marker>
      </defs>

      {/* column headers */}
      <text class="sv-mono sv-caps sv-muted" font-size="11" text-anchor="middle" x="107" y="30">Вход</text>
      <text class="sv-mono sv-caps sv-muted" font-size="11" text-anchor="middle" x="340" y="30">Распределение</text>
      <text class="sv-mono sv-caps sv-muted" font-size="11" text-anchor="middle" x="662" y="30">AI-агенты</text>
      <text class="sv-mono sv-caps sv-muted" font-size="11" text-anchor="middle" x="1052" y="30">Выход</text>

      {/* input */}
      <rect class="sv-box" x="25" y="50" width="165" height="86" />
      <text class="sv-title" x="107" y="82" text-anchor="middle" font-size="15">Материалы</text>
      <text class="sv-mono sv-muted" x="107" y="104" text-anchor="middle" font-size="12">PDF, брифы, видео,</text>
      <text class="sv-mono sv-muted" x="107" y="120" text-anchor="middle" font-size="12">расшифровки</text>

      {/* the methodologist */}
      <rect class="sv-box sv-box--strong" x="25" y="420" width="165" height="96" />
      <text class="sv-title" x="107" y="448" text-anchor="middle" font-size="15">Методист (я)</text>
      <text class="sv-mono sv-muted" x="107" y="470" text-anchor="middle" font-size="12">ставит задачу,</text>
      <text class="sv-mono sv-muted" x="107" y="486" text-anchor="middle" font-size="12">проверяет программу</text>
      <text class="sv-mono sv-muted" x="107" y="502" text-anchor="middle" font-size="12">и каждый урок</text>

      {/* distributor */}
      <rect class="sv-box" x="255" y="232" width="170" height="96" />
      <text class="sv-title" x="340" y="266" text-anchor="middle" font-size="15">Распределитель</text>
      <text class="sv-mono sv-muted" x="340" y="290" text-anchor="middle" font-size="12">отправляет задачу</text>
      <text class="sv-mono sv-muted" x="340" y="306" text-anchor="middle" font-size="12">нужной группе агентов</text>

      <path class="sv-line" d="M190,93 H340 V226" marker-end={arrow} />
      <path class="sv-line" d="M107,417 V280 H249" marker-end={arrow} />
      <text class="sv-mono sv-muted" x="178" y="271" text-anchor="middle" font-size="12">задача</text>

      {/* group: course programme */}
      <rect class="sv-frame" x="470" y="55" width="384" height="110" />
      <text class="sv-mono sv-caps" x="482" y="78" font-size="11">Программа курса</text>
      <rect class="sv-box" x="488" y="95" width="104" height="44" />
      <text class="sv-title" x="540" y="122" text-anchor="middle" font-size="12.5">черновик</text>
      <rect class="sv-box" x="612" y="95" width="104" height="44" />
      <text class="sv-title" x="664" y="122" text-anchor="middle" font-size="12.5">критика</text>
      <rect class="sv-box" x="736" y="95" width="104" height="44" />
      <text class="sv-title" x="788" y="122" text-anchor="middle" font-size="12.5">оценка</text>
      <path class="sv-line" d="M592,117 H606" marker-end={arrow} />
      <path class="sv-line" d="M716,117 H730" marker-end={arrow} />

      {/* group: lessons */}
      <rect class="sv-frame" x="470" y="205" width="384" height="140" />
      <text class="sv-mono sv-caps" x="482" y="228" font-size="11">Уроки</text>
      <rect class="sv-box" x="484" y="245" width="80" height="44" />
      <text class="sv-title" x="524" y="272" text-anchor="middle" font-size="12">разбор</text>
      <rect class="sv-box" x="578" y="245" width="80" height="44" />
      <text class="sv-title" x="618" y="272" text-anchor="middle" font-size="12">редактура</text>
      <rect class="sv-box" x="672" y="245" width="80" height="44" />
      <text class="sv-title" x="712" y="264" text-anchor="middle" font-size="11.5">проверка</text>
      <text class="sv-title" x="712" y="279" text-anchor="middle" font-size="11.5">формы</text>
      <rect class="sv-box" x="766" y="245" width="80" height="44" />
      <text class="sv-title" x="806" y="264" text-anchor="middle" font-size="11.5">проверка</text>
      <text class="sv-title" x="806" y="279" text-anchor="middle" font-size="11.5">правил</text>
      <path class="sv-line" d="M564,267 H572" marker-end={arrow} />
      <path class="sv-line" d="M658,267 H666" marker-end={arrow} />
      <path class="sv-line" d="M752,267 H760" marker-end={arrow} />
      <path class="sv-line sv-dash" d="M806,289 V318 H618 V295" marker-end={arrow} />
      <text class="sv-mono" x="712" y="335" text-anchor="middle" font-size="11">агенты сами чинят то, что нашли проверки</text>

      {/* group: translations */}
      <rect class="sv-frame" x="470" y="385" width="384" height="105" />
      <text class="sv-mono sv-caps" x="482" y="408" font-size="11">Переводы</text>
      <rect class="sv-box" x="484" y="420" width="158" height="46" />
      <text class="sv-title" x="563" y="440" text-anchor="middle" font-size="12">распределитель</text>
      <text class="sv-title" x="563" y="456" text-anchor="middle" font-size="12">переводов</text>
      <rect class="sv-box" x="676" y="420" width="166" height="46" />
      <text class="sv-title" x="759" y="440" text-anchor="middle" font-size="11.5">1 агент =</text>
      <text class="sv-title" x="759" y="456" text-anchor="middle" font-size="11.5">1 файл × 1 язык</text>
      <path class="sv-line" d="M642,443 H670" marker-end={arrow} />
      <text class="sv-mono sv-muted" x="662" y="483" text-anchor="middle" font-size="12">с английского на 4 языка</text>

      {/* distributor to the groups */}
      <path class="sv-line" d="M425,250 H448 V110 H464" marker-end={arrow} />
      <path class="sv-line" d="M425,275 H464" marker-end={arrow} />
      <path class="sv-line" d="M425,300 H448 V437 H464" marker-end={arrow} />

      {/* human checks */}
      <polygon class="sv-gate" points="893,88 915,110 893,132 871,110" />
      <text class="sv-mono" x="893" y="60" text-anchor="middle" font-size="12">проверка</text>
      <text class="sv-mono" x="893" y="75" text-anchor="middle" font-size="12">программы</text>
      <polygon class="sv-gate" points="893,253 915,275 893,297 871,275" />
      <text class="sv-mono" x="893" y="225" text-anchor="middle" font-size="12">проверка</text>
      <text class="sv-mono" x="893" y="240" text-anchor="middle" font-size="12">урока</text>

      <path class="sv-line" d="M854,110 H865" marker-end={arrow} />
      <path class="sv-line" d="M854,275 H865" marker-end={arrow} />
      <path class="sv-line" d="M893,132 V180 H700 V199" marker-end={arrow} />
      <text class="sv-mono sv-muted" x="800" y="196" text-anchor="middle" font-size="11">программа идёт в уроки</text>

      {/* the methodologist makes both checks */}
      <path class="sv-line sv-dot" d="M107,519 V538 H893 V304" marker-end={arrow} />
      <text class="sv-mono" x="500" y="530" text-anchor="middle" font-size="12">обе проверки делает человек</text>

      {/* output */}
      <rect class="sv-box" x="950" y="225" width="205" height="58" />
      <text class="sv-title" x="1052" y="250" text-anchor="middle" font-size="14">Форматирование</text>
      <text class="sv-mono sv-muted" x="1052" y="270" text-anchor="middle" font-size="12">под учебную платформу</text>
      <rect class="sv-box" x="950" y="318" width="205" height="58" />
      <text class="sv-title" x="1052" y="343" text-anchor="middle" font-size="14">Сборка</text>
      <text class="sv-mono sv-muted" x="1052" y="363" text-anchor="middle" font-size="12">раскладывает материалы</text>
      <rect class="sv-solid" x="950" y="415" width="205" height="70" />
      <text class="sv-title sv-on-ink" x="1052" y="445" text-anchor="middle" font-size="17">Готовый курс</text>
      <text class="sv-mono sv-on-ink" x="1052" y="468" text-anchor="middle" font-size="12">в учебной платформе</text>

      <path class="sv-line" d="M915,275 H932 V253 H944" marker-end={arrow} />
      <path class="sv-line" d="M854,443 H932 V347 H944" marker-end={arrow} />
      <path class="sv-line" d="M1052,283 V312" marker-end={arrow} />
      <path class="sv-line" d="M1052,376 V409" marker-end={arrow} />

      {/* shared base */}
      <rect class="sv-frame" x="25" y="560" width="1135" height="72" />
      <text class="sv-mono sv-caps" x="45" y="586" font-size="11">Общая основа для всех агентов</text>
      <text class="sv-muted" x="45" y="612" font-size="13">типы заданий, правила курса, словари терминов, скрипты-проверки, потолок расходов на нейросети</text>
      <path class="sv-line sv-thin sv-dot" d="M640,558 V505" marker-end={arrow} />
      <path class="sv-line sv-thin sv-dot" d="M760,558 V505" marker-end={arrow} />
    </svg>
  </div>

  {/* narrow containers: the same scheme as a list, top to bottom */}
  <div class="ast" role="group" aria-label={title}>
    <ol class="ast__stages" role="list">
      <li class="ast__stage">
        <p class="ast__name">Вход</p>
        <div class="ast__boxes">
          <p class="ast__box">
            <span class="ast__title">Материалы</span> <span class="ast__sub">PDF, брифы, видео, расшифровки</span>
          </p>
          <p class="ast__box ast__box--strong">
            <span class="ast__title">Методист (я)</span>
            <span class="ast__sub">ставит задачу, проверяет программу и каждый урок</span>
          </p>
        </div>
      </li>
      <li class="ast__stage">
        <p class="ast__via">задача</p>
        <p class="ast__name">Распределение</p>
        <p class="ast__box">
          <span class="ast__title">Распределитель</span> <span class="ast__sub">отправляет задачу нужной группе агентов</span>
        </p>
      </li>
      <li class="ast__stage">
        <p class="ast__name">AI-агенты</p>
        <div class="ast__groups">
          <div class="ast__group">
            <p class="ast__gname">Программа курса</p>
            <div class="ast__clip">
              <ol class="ast__steps" role="list">
                <li>черновик</li>
                <li>критика</li>
                <li>оценка</li>
              </ol>
            </div>
            <p class="ast__gate">проверка программы</p>
            <p class="ast__foot">программа идёт в уроки</p>
          </div>
          <div class="ast__group">
            <p class="ast__gname">Уроки</p>
            <div class="ast__clip">
              <ol class="ast__steps" role="list">
                <li>разбор</li>
                <li>редактура</li>
                <li>проверка формы</li>
                <li>проверка правил</li>
              </ol>
            </div>
            <p class="ast__foot ast__foot--loop">агенты сами чинят то, что нашли проверки</p>
            <p class="ast__gate">проверка урока</p>
          </div>
          <div class="ast__group">
            <p class="ast__gname">Переводы</p>
            <div class="ast__clip">
              <ol class="ast__steps" role="list">
                <li>распределитель переводов</li>
                <li>1 агент = 1 файл × 1 язык</li>
              </ol>
            </div>
            <p class="ast__foot">с английского на 4 языка</p>
          </div>
        </div>
        <p class="ast__human">обе проверки делает человек</p>
      </li>
      <li class="ast__stage">
        <p class="ast__name">Выход</p>
        <div class="ast__boxes ast__boxes--chain">
          <p class="ast__box">
            <span class="ast__title">Форматирование</span> <span class="ast__sub">под учебную платформу</span>
          </p>
          <p class="ast__box">
            <span class="ast__title">Сборка</span> <span class="ast__sub">раскладывает материалы</span>
          </p>
          <p class="ast__box ast__box--solid">
            <span class="ast__title">Готовый курс</span> <span class="ast__sub">в учебной платформе</span>
          </p>
        </div>
      </li>
    </ol>
    <div class="ast__base">
      <p class="ast__gname">Общая основа для всех агентов</p>
      <p class="ast__basetext">типы заданий, правила курса, словари терминов, скрипты-проверки, потолок расходов на нейросети</p>
    </div>
  </div>
  {
    factList.length > 0 && (
      <div class="agents-scheme__wrapfacts">
        <ul class="agents-scheme__facts" role="list">
          {factList.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .agents-scheme {
    display: grid;
    gap: var(--s2);
    container-type: inline-size;
    min-width: 0;
  }

  .agents-scheme__title--medium {
    font-size: var(--fs-medium);
    line-height: var(--lh-medium);
    letter-spacing: var(--track-medium);
  }

  .agents-scheme__title--base {
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    letter-spacing: 0;
  }

  /* The drawing keeps its size and scrolls sideways when the column is narrower. */
  .agents-scheme__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border-top: var(--line);
    border-bottom: var(--hair);
    padding-block: var(--s2);
  }

  .agents-scheme__svg {
    display: block;
    width: 100%;
    min-width: 1180px;
    height: auto;
    color: var(--ink);
    font-family: var(--font-sans);
  }

  /* Only while the drawing scrolls (720–1179px); it stands above the drawing. */
  .agents-scheme__hint {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--muted);
  }

  @container (min-width: 720px) and (max-width: 1179px) {
    .agents-scheme__hint {
      display: block;
    }
  }

  /* Below 720px: the list instead of the drawing */
  .ast {
    display: none;
  }

  @container (max-width: 719px) {
    .agents-scheme__scroll {
      display: none;
    }

    .ast {
      display: grid;
      gap: var(--s2);
      border-top: var(--line);
      padding-top: var(--s2);
    }
  }

  .ast__stages {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  .ast__stage {
    position: relative;
    display: grid;
    gap: var(--s1);
  }

  /* the connector into every stage after the first: a rule and an arrowhead */
  .ast__stage + .ast__stage {
    padding-top: 2.25rem;
  }

  .ast__stage + .ast__stage::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 0.375rem;
    height: 1.25rem;
    border-left: 1.5px solid var(--ink);
  }

  .ast__stage + .ast__stage::after {
    content: '';
    position: absolute;
    left: calc(1.25rem - 4.25px);
    top: 1.5rem;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid var(--ink);
  }

  .ast__via {
    position: absolute;
    left: 2rem;
    top: 0.5rem;
  }

  .ast__name,
  .ast__gname {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ast__name {
    color: var(--muted);
  }

  .ast__via,
  .ast__sub,
  .ast__foot,
  .ast__gate,
  .ast__human {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .ast__boxes {
    display: grid;
    gap: var(--s1);
  }

  /* output: three boxes joined by short rules */
  .ast__boxes--chain {
    gap: 0.875rem;
  }

  .ast__boxes--chain > .ast__box + .ast__box::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: calc(-0.875rem - 1.5px);
    height: 0.875rem;
    border-left: 1.5px solid var(--ink);
  }

  .ast__box {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 0.625rem 0.75rem;
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }

  .ast__box--strong {
    border-width: 3px;
  }

