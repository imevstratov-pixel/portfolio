---
// One free material on /free/ (an item of the "free-items" block of
// pages/free.md, decision 18): the cover, the kind as a mono label, the title,
// who it is for, «Что внутри» as a dash list, the format line, «Скачать PDF»
// (a direct download of the file, its size as the button's second line) and
// the line about the consultation and the audit with links to their cards.
//
// The file must exist in public/. Its size is read at build time; for a PDF
// the number of pages in `format` («PDF, 15 страниц») is checked against the
// file and the build fails when they differ (the PDF was rebuilt: fix the
// number in the content). Both download links carry the goal "download".
// The cover link is for the mouse only (tabindex="-1" aria-hidden="true"):
// keyboard and screen-reader users get one download link, the button.
//
// `isNew: true` puts the «new» sticker (NewBadge) on the top-left corner of
// the item, over the corner of the cover.
//
// A material that is a page on the site (a competency matrix, /free/<slug>/)
// has `page` and `pageLabel`: the main button opens the page, the file (an
// Excel table) is a second, outlined download button, and the cover link
// opens the page too. `coverArt: matrix` draws the cover in HTML (a small grid
// of ticked and empty squares, decorative) when there is no cover image.
//
// Layout: an ink line on top. Phones: the cover at half the width, then the
// text. From 720px 12 columns: the cover in 1-4, the text in 6-12; from
// 1080px the cover in 1-3, the text in 5-11.
import Media from '../Media.astro';
import NewBadge from '../NewBadge.astro';
import LinkedText from '../LinkedText.astro';
import { url } from '../../lib/url';
import { fileSize, formatSize, pdfPageCount, publicFileExists } from '../../lib/media';
import { visible, type TextLink } from '../../lib/content';

export type FreeItemData = {
  id: string;
  anchor?: string;
  kind?: string;
  title: string;
  text?: string;
  insideLabel?: string;
  inside?: string[];
  format?: string;
  file: string;
  cover?: { src: string; alt: string };
  downloadLabel: string;
  discuss?: { text: string; links?: TextLink[] };
  isNew?: boolean;
  page?: string;
  pageLabel?: string;
  coverArt?: 'matrix';
};

interface Props {
  item: FreeItemData;
  /** The first item on the page: its cover loads eagerly. */
  first?: boolean;
}

const { item, first = false } = Astro.props;
const where = `pages/free item "${item.id}"`;
for (const f of ['id', 'title', 'file', 'downloadLabel'] as const) {
  if (!item[f]) throw new Error(`${where}: "${f}" is missing`);
}
if (!publicFileExists(item.file)) throw new Error(`${where}: ${item.file} is not in public/`);

const id = item.anchor ?? item.id;
const fileName = item.file.split('/').pop();
const size = formatSize(fileSize(item.file));
if (/\.pdf$/i.test(item.file) && item.format) {
  const stated = Number(item.format.match(/(\d+)\s+страниц/)?.[1] ?? 0);
  const pages = pdfPageCount(item.file);
  if (stated && pages && stated !== pages) {
    throw new Error(`${where}: the content says «${item.format}», ${item.file} has ${pages} pages`);
  }
}
const inside = visible(item.inside ?? []);
const cover = item.cover?.src ? item.cover : undefined;
const art = !cover && item.coverArt === 'matrix';
if (item.page && !item.pageLabel) throw new Error(`${where}: "page" needs "pageLabel"`);
const fileType = /\.xlsx$/i.test(item.file)
  ? 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
  : /\.pdf$/i.test(item.file)
    ? 'application/pdf'
    : undefined;
// the matrix art: 9 rows of 3 squares, a fixed pattern of ticked ones
const ART = ['110', '111', '100', '110', '111', '010', '110', '100', '111'];
---

<article id={id} class:list={['free', (cover || art) && 'free--cover']} aria-labelledby={`${id}-title`}>
  {item.isNew && <NewBadge class="free__new" />}
  {
    cover &&
      (item.page ? (
        <a class="free__cover" href={url(item.page)} tabindex="-1" aria-hidden="true">
          <Media type="image" src={cover.src} alt={cover.alt} loading={first ? 'eager' : 'lazy'} />
        </a>
      ) : (
        <a class="free__cover" href={url(item.file)} download={fileName} tabindex="-1" aria-hidden="true" data-goal="download">
          <Media type="image" src={cover.src} alt={cover.alt} loading={first ? 'eager' : 'lazy'} />
        </a>
      ))
  }
  {
    art && (
      <a class="free__cover free__art" href={url(item.page ?? item.file)} tabindex="-1" aria-hidden="true">
        <span class="free__art-head">
          <span>J</span>
          <span>M</span>
          <span>S</span>
        </span>
        {ART.map((row) => (
          <span class="free__art-row">
            {[...row].map((c) => (
              <span class:list={['free__art-cell', c === '1' && 'is-on']} />
            ))}
          </span>
        ))}
      </a>
    )
  }
  <div class="free__body">
    <header class="free__head">
      {item.kind && <p class="label">{item.kind}</p>}
      <h2 id={`${id}-title`} class="free__title t-large">{item.title}</h2>
    </header>
    {item.text && <p class="free__text">{item.text}</p>}
    {
      inside.length > 0 && (
        <div class="free__inside">
          {item.insideLabel && <h3 class="label free__label">{item.insideLabel}</h3>}
          <ul class="list-dash" role="list">
            {inside.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="free__get">
      {item.format && <p class="label free__format">{item.format}</p>}
      <div class="free__buttons">
        {
          item.page && (
            <a class="btn btn--primary" href={url(item.page)}>
              <span class="btn__label">{item.pageLabel}</span>
            </a>
          )
        }
        <a class:list={['btn', !item.page && 'btn--primary']} href={url(item.file)} download={fileName} type={fileType} data-goal="download">
          <span class="btn__label">{item.downloadLabel}</span>
          <span class="btn__caption">{size}</span>
        </a>
      </div>
    </div>
    {
      item.discuss?.text && (
        <p class="free__discuss">
          <LinkedText text={item.discuss.text} links={item.discuss.links} where={where} />
        </p>
      )
    }
  </div>
</article>

<style>
  .free {
    position: relative;
    border-top: var(--line);
    padding-top: var(--s3);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: var(--s3);
    align-items: start;
  }

  .free__cover {
    grid-column: 1 / span 2;
    display: block;
  }

  /* the cover is a white page on a white page: a hairline frame, as the
     screenshots on /products/ */
  .free__cover :global(.media) {
    outline: var(--hair);
    outline-offset: -1px;
  }

  /* the sticker's centre near the corner of the cover; on phones it keeps
     inside the 16px margin of the page */
  .free :global(.free__new) {
    --nb-size: 4rem;
    position: absolute;
    z-index: 1;
    top: calc(var(--s3) - 1.25rem);
    left: -0.625rem;
  }

  .free__body {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s3);
    justify-items: start;
    min-width: 0;
  }

  .free__head {
    display: grid;
    gap: var(--s1);
  }

  .free__title {
    max-width: 16em;
  }

  .free__text {
    max-width: var(--measure);
    font-size: var(--fs-medium);
    line-height: 1.4;
    letter-spacing: var(--track-medium);
  }

  .free__inside {
    display: grid;
    gap: var(--s1);
  }

  .free__label {
    font-weight: var(--regular);
  }

  .free__get {
    display: grid;
    gap: var(--s1);
    justify-items: start;
  }

  .free__discuss {
    max-width: var(--measure);
  }

  .free__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    align-items: stretch;
  }

  /* the drawn matrix cover: a framed sheet with three grade columns of
     squares, some of them ticked (ink) */
  .free__art {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    aspect-ratio: 1 / 1.414;
    /* the top clears the «new» sticker on the corner */
    padding: max(14%, 3.25rem) 14% 10%;
    text-decoration: none;
    background-image: none;
    color: var(--ink);
    outline: var(--hair);
    outline-offset: -1px;
    background: var(--paper);
  }

  .free__art-head,
  .free__art-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .free__art-head {
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    text-align: center;
  }

  .free__art-cell {
    display: block;
    aspect-ratio: 2 / 1;
    border: var(--line);
  }

  .free__art-cell.is-on {
    background: var(--ink);
    box-shadow: inset 0 0 0 3px var(--paper);
  }

  @media (min-width: 720px) {
    .free {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .free__cover {
      grid-column: 1 / span 4;
    }

    .free__body {
      grid-column: 6 / span 7;
    }

    .free:not(.free--cover) .free__body {
      grid-column: 1 / span 9;
    }

    .free :global(.free__new) {
      --nb-size: 4.75rem;
      top: calc(var(--s3) - 1.75rem);
      left: -1.75rem;
    }
  }

  @media (min-width: 1080px) {
    .free__cover {
      grid-column: 1 / span 3;
    }

    .free__body {
      grid-column: 5 / span 7;
    }
  }
</style>
