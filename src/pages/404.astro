---
// 404 (pages/404.md, block "not-found"): the code in large mono, the h1 in
// the huge size, the line under it, then «На главную» as the primary button
// with the two text links beside it. No contact block here, so «Написать»
// in the header points to the contact block of the home page.
// seo.noindex: robots noindex and no canonical (BaseLayout).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getPage, getBlock, visible } from '../lib/content';
import { url } from '../lib/url';

const page = getPage('404');
const nf = getBlock(page, 'not-found');
const links = visible<{ label: string; href: string }>(nf.links).filter((l) => l?.href && l?.label);
---

<BaseLayout page={page} ctaHref="/#contact">
  <section class="nf" aria-labelledby="nf-heading">
    <div class="wrap">
      <div class="nf__inner">
        {nf.code && <p class="nf__code">{nf.code}</p>}
        <h1 id="nf-heading" class="nf__heading">{nf.heading}</h1>
        {nf.text && <p class="nf__text lead">{nf.text}</p>}
        {
          (nf.button?.href || links.length > 0) && (
            <div class="nf__actions">
              {nf.button?.href && (
                <Button href={nf.button.href} variant="primary">
                  {nf.button.label}
                </Button>
              )}
              {links.length > 0 && (
                <ul class="nf__links" role="list">
                  {links.map((l) => (
                    <li>
                      <a href={url(l.href)}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-top: var(--s5);
  }

  .nf__inner {
    padding-top: var(--s2);
    border-top: var(--line);
  }

  .nf__code {
    font-family: var(--font-mono);
    font-size: var(--fs-large);
    line-height: 1;
    letter-spacing: 0;
  }

  .nf__heading {
    margin-top: var(--s3);
    max-width: 10em;
  }

  .nf__text {
    margin-top: var(--s3);
  }

  .nf__actions {
    margin-top: var(--s4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
  }
</style>
