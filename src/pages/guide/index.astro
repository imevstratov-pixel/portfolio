---
// /guide/: the blocks of pages/guide.md in content order, as render_guide()
// in the texts renderer: hero (h1 and the «Гайд» button), «Узнаёте себя?»
// with the story, quote, task and demo, the numbered blocks («Что входит»,
// «Что будет с данными вашего близкого»), #faq, «Кто я» and #contact.
// «Написать» in the header points to #contact (pages/guide.md header).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import FAQ from '../../components/FAQ.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import GuideHero from '../../components/guide/GuideHero.astro';
import GuideRecognize from '../../components/guide/GuideRecognize.astro';
import GuideNumbered from '../../components/guide/GuideNumbered.astro';
import GuideAbout from '../../components/guide/GuideAbout.astro';
import { getPage, pageBlocks } from '../../lib/content';

const page = getPage('guide');
const blocks = pageBlocks(page);

const known = new Set(['hero', 'recognize', 'numbered', 'faq', 'about', 'contact']);
for (const b of blocks) {
  if (!known.has(b.type)) throw new Error(`/guide/: block "${b.id}" has unknown type "${b.type}"`);
}
---

<BaseLayout page={page} current="/guide/">
  {
    blocks.map((b) =>
      b.type === 'hero' ? (
        <GuideHero block={b} />
      ) : b.type === 'recognize' ? (
        <GuideRecognize block={b} />
      ) : b.type === 'numbered' ? (
        <GuideNumbered block={b} />
      ) : b.type === 'faq' ? (
        <Section id={b.anchor ?? 'faq'} heading={b.heading}>
          <div class="grid">
            <FAQ items={b.items ?? []} open class="lg-col-8" />
          </div>
        </Section>
      ) : b.type === 'about' ? (
        <GuideAbout block={b} />
      ) : (
        <ContactBlock block={b} />
      ),
    )
  }
</BaseLayout>
